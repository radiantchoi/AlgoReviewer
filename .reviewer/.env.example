# Choose one: local or opencode
LLM_PROVIDER=local

# Local (oMLX)
OMLX_API_URL=http://127.0.0.1:8808/v1/chat/completions
OMLX_MODEL=oMLX에_등록된_모델_ID
OMLX_API_KEY=당신의_oMLX_API_키

# OpenCode (sign in with /connect, then select OpenAI > ChatGPT Plus/Pro)
# Optional overrides. Leave both unset to use OpenCode's configured/default model and variant.
# OPENCODE_MODEL=openai/gpt-6-luna
# OPENCODE_VARIANT=high
